---
import Layout from '../layouts/Layout.astro';
import StructuredData from '../components/StructuredData.astro';
import { getCollection } from 'astro:content';
import consultations from '../data/consultations.json';
import { PROJECT_CATEGORIES, PARTNER_TYPES } from '../lib/project-vocab';

function sortYear(years?: string): number {
  if (!years) return 0;
  const matches = years.match(/\d{4}/g);
  if (!matches) return 0;
  return years.includes('present') ? 9999 : Number(matches[matches.length - 1]);
}

const institutions = (await getCollection('institutions'))
  .filter((i) => i.data.active)
  .sort((a, b) => a.data.name.localeCompare(b.data.name));
const instName = (id: string) => institutions.find((i) => i.id === id)?.data.name ?? id;

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) =>
    Number(b.data.status === 'current') - Number(a.data.status === 'current') ||
    sortYear(b.data.years) - sortYear(a.data.years) ||
    a.data.title.localeCompare(b.data.title)
);

// Filter choices, each with how many projects it would show.
const programOptions = institutions.map((i) => ({
  value: i.id,
  label: i.data.name,
  n: projects.filter((p) => p.data.institutions.includes(i.id)).length,
}));
const workOptions = PROJECT_CATEGORIES.map((c) => ({
  value: c as string,
  label: c as string,
  n: projects.filter((p) => (p.data.category as string[]).includes(c)).length,
})).filter((o) => o.n > 0);
const forLabel: Record<string, string> = {
  research: 'Researchers',
  instruction: 'Courses and instructors',
  'campus-operations': 'Campus offices',
  internal: 'The program itself',
};
const forOptions = PARTNER_TYPES.map((t) => ({
  value: t as string,
  label: forLabel[t],
  n: projects.filter((p) => p.data.partnerType === t).length,
})).filter((o) => o.n > 0);

const records = consultations.programs.map((p) => ({
  name: instName(p.institution),
  ...p,
  max: Math.max(...p.notes.byYear.map((y) => y.count)),
}));

const site = Astro.site ?? new URL('https://datasquad.info');
const itemList = {
  '@type': 'CollectionPage',
  name: 'DataSquad examples',
  url: new URL('/projects', site).href,
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: projects.length,
    itemListElement: projects.map((p, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: p.data.url ?? new URL(`/projects/${p.id}`, site).href,
      name: p.data.title,
    })),
  },
};
---

<Layout
  title="Examples | DataSquad International"
  description="What DataSquad student analysts have built at member institutions, with filters for the kind of work and who it was for."
>
  <StructuredData slot="head" schema={itemList} />

  <section class="hero">
    <div class="inner">
      <h1>Examples</h1>
      <p class="lede">
        {projects.length} projects from {institutions.length} programs. Carleton
        started the DataSquad model, so it has the longer record: its program is
        older and has had more students.
      </p>
    </div>
  </section>

  {projects.length === 0 ? (
    <section class="wrap">
      <div class="empty">
        <p>
          We're collecting standout work from across the network. In the meantime,
          recent updates and project recaps live on the <a href="/blog">blog</a>.
        </p>
        <p class="small">
          Run a DataSquad and have work to feature? <a href="/contact">Get in touch</a>.
        </p>
      </div>
    </section>
  ) : (
    <>
      <section class="wrap filters-section" aria-labelledby="filters-h">
        <h2 id="filters-h" class="vh">Filter the examples</h2>
        <!-- Shown by script; without it the full list below is simply unfiltered. -->
        <div class="filters" id="filters" role="group" aria-labelledby="filters-h" hidden>
          <div class="field">
            <label for="f-program">Program</label>
            <select id="f-program" name="program">
              <option value="">All programs</option>
              {programOptions.map((o) => <option value={o.value}>{o.label} ({o.n})</option>)}
            </select>
          </div>
          <div class="field">
            <label for="f-work">Kind of work</label>
            <select id="f-work" name="work">
              <option value="">All kinds of work</option>
              {workOptions.map((o) => <option value={o.value}>{o.label} ({o.n})</option>)}
            </select>
          </div>
          <div class="field">
            <label for="f-for">Who it was for</label>
            <select id="f-for" name="for">
              <option value="">Anyone</option>
              {forOptions.map((o) => <option value={o.value}>{o.label} ({o.n})</option>)}
            </select>
          </div>
          <button type="button" class="clear" id="clear" hidden>Clear filters</button>
        </div>
        <p class="count" id="count" role="status" aria-live="polite" hidden>
          Showing <span id="shown">{projects.length}</span> of {projects.length} projects.
        </p>
        <p class="none" id="none" hidden>
          No projects match those filters. Try clearing one of them.
        </p>
      </section>

      <section class="wrap list-section" aria-labelledby="list-h">
        <h2 id="list-h" class="vh">All projects</h2>
        <ol class="ledger" id="ledger">
          {projects.map((p) => {
            const href = p.data.url ?? `/projects/${p.id}`;
            const external = Boolean(p.data.url);
            const when = p.data.status === 'current' ? 'Current' : p.data.years;
            return (
              <li
                class="row"
                id={`p-${p.id}`}
                data-program={p.data.institutions.join(' ')}
                data-work={p.data.category.join('|')}
                data-for={p.data.partnerType ?? ''}
              >
                {p.data.heroImage ? (
                  <img src={p.data.heroImage} alt="" loading="lazy" class="thumb" />
                ) : (
                  <div class="thumb blank" aria-hidden="true"></div>
                )}
                <div class="body">
                  <h3>
                    <a
                      href={href}
                      target={external ? '_blank' : undefined}
                      rel={external ? 'noopener' : undefined}
                    >
                      {p.data.title}{external && ' (opens in a new tab)'}
                    </a>
                  </h3>
                  <p class="dek">{p.data.description}</p>
                  <dl class="facts">
                    <div>
                      <dt>Program</dt>
                      <dd>{p.data.institutions.map(instName).join(', ')}</dd>
                    </div>
                    {when && (
                      <div>
                        <dt>{p.data.status === 'current' ? 'Status' : 'Years'}</dt>
                        <dd>{when}</dd>
                      </div>
                    )}
                    {p.data.partner && (
                      <div>
                        <dt>For</dt>
                        <dd>{p.data.partner}</dd>
                      </div>
                    )}
                    {p.data.team.length > 0 && (
                      <div>
                        <dt>By</dt>
                        <dd>{p.data.team.join(', ')}</dd>
                      </div>
                    )}
                    {p.data.selection === 'logged' && (
                      <div>
                        <dt>Listing</dt>
                        <dd>From the program's complete record</dd>
                      </div>
                    )}
                    {p.data.category.length > 0 && (
                      <div>
                        <dt>Work</dt>
                        <dd>{p.data.category.join(', ')}</dd>
                      </div>
                    )}
                  </dl>
                </div>
              </li>
            );
          })}
        </ol>
      </section>

      <section class="wrap behind" aria-labelledby="behind-h">
        <h2 id="behind-h">How much work is behind these examples</h2>
        <p class="note">
          The examples are a selection. Each program keeps a fuller record of its
          consultations, and this is what UCLA's shows.
        </p>
        {records.map((r) => (
          <div class="record">
            <h3>{r.name}</h3>
            <table class="years">
              <caption>
                About {r.notes.total} {r.notes.label}, by year
              </caption>
              <thead>
                <tr><th scope="col">Year</th><th scope="col">Notes</th><th scope="col"><span class="vh">Relative size</span></th></tr>
              </thead>
              <tbody>
                {r.notes.byYear.map((y) => (
                  <tr>
                    <th scope="row">{y.year}</th>
                    <td>about {y.count}{y.partial && ` (${y.partial})`}</td>
                    <td aria-hidden="true"><span class="bar" style={`--w: ${(y.count / r.max) * 100}%`}></span></td>
                  </tr>
                ))}
              </tbody>
            </table>
            <p class="line">
              {r.board.label}: {r.board.total}, of which
              {' '}{r.board.status.map((s) => `${s.count} ${s.label}`).join(', ')}.
              Some 2025 projects appear in both records, so the two counts overlap
              and shouldn't be added together.
            </p>
            <p class="line">
              Requests that recur: {r.topics.join(', ')}.
            </p>
          </div>
        ))}
        <p class="note small">
          We don't have Carleton's equivalent counts on the site yet. Counts are
          approximate, tallied from file titles and dates. Individual consultations
          are confidential, so none are listed.
        </p>
      </section>
    </>
  )}
</Layout>

<script>
  // Progressive enhancement: filter the list by program, kind of work and who it
  // was for. Choices live in the URL (?program=&work=&for=) so a filtered view can
  // be shared or put behind a QR code.
  const form = document.getElementById('filters');
  if (form) {
    const rows = Array.from(document.querySelectorAll<HTMLElement>('#ledger .row'));
    const count = document.getElementById('count')!;
    const shown = document.getElementById('shown')!;
    const none = document.getElementById('none')!;
    const clear = document.getElementById('clear')!;
    const program = document.getElementById('f-program') as HTMLSelectElement;
    const work = document.getElementById('f-work') as HTMLSelectElement;
    const forWho = document.getElementById('f-for') as HTMLSelectElement;

    const params = new URLSearchParams(location.search);
    for (const [name, el] of [['program', program], ['work', work], ['for', forWho]] as const) {
      const v = params.get(name);
      if (v && Array.from(el.options).some((o) => o.value === v)) el.value = v;
    }

    const apply = () => {
      let n = 0;
      for (const row of rows) {
        const ok =
          (!program.value || (row.dataset.program ?? '').split(' ').includes(program.value)) &&
          (!work.value || (row.dataset.work ?? '').split('|').includes(work.value)) &&
          (!forWho.value || row.dataset.for === forWho.value);
        row.hidden = !ok;
        if (ok) n++;
      }
      shown.textContent = String(n);
      none.hidden = n !== 0;
      const filtered = Boolean(program.value || work.value || forWho.value);
      clear.hidden = !filtered;
      const next = new URLSearchParams();
      if (program.value) next.set('program', program.value);
      if (work.value) next.set('work', work.value);
      if (forWho.value) next.set('for', forWho.value);
      const qs = next.toString();
      history.replaceState(null, '', qs ? `?${qs}` : location.pathname);
    };

    form.addEventListener('change', apply);
    clear.addEventListener('click', () => {
      program.value = work.value = forWho.value = '';
      apply();
      program.focus();
    });

    form.hidden = false;
    count.hidden = false;
    apply();
  }
</script>

<style>
  .hero { background: var(--color-navy); color: var(--color-white); }
  .hero .inner { max-width: var(--max-width); margin: 0 auto; padding: var(--space-12) var(--space-6); }
  .hero h1 { margin: 0 0 var(--space-3); color: var(--color-white); font-size: var(--text-4xl); }
  .lede { margin: 0; font-size: var(--text-lg); color: #cdd6e3; max-width: 56ch; }

  .wrap { max-width: var(--max-width); margin: 0 auto; padding: var(--space-8) var(--space-6) 0; }
  .wrap h2 { margin: 0 0 var(--space-2); font-size: var(--text-2xl); color: var(--color-navy); }
  .note { margin: 0 0 var(--space-4); color: var(--color-muted); max-width: 62ch; }
  .list-section { padding-top: var(--space-4); }
  .behind { padding-top: var(--space-16); padding-bottom: var(--space-16); }

  .vh {
    position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }

  .empty { max-width: 60ch; }
  .empty p { font-size: var(--text-lg); color: #555; margin: 0 0 var(--space-4); }
  .empty .small { font-size: var(--text-base); color: var(--color-muted); }
  .empty a { color: var(--color-link); font-weight: 700; }

  /* Filters */
  .filters-section { padding-bottom: 0; }
  .filters { display: flex; flex-wrap: wrap; align-items: flex-end; gap: var(--space-4) var(--space-6); }
  .filters[hidden], .count[hidden], .none[hidden], .clear[hidden] { display: none; }
  .field { display: grid; gap: var(--space-1); min-width: 0; flex: 1 1 17rem; max-width: 24rem; }
  .field label { font-size: var(--text-sm); font-weight: 700; color: var(--color-navy); }
  .field select {
    width: 100%; min-width: 0; font: inherit; padding: var(--space-2) var(--space-3); color: var(--color-slate);
    background: var(--color-white); border: 1px solid #9aa4b0; border-radius: 4px;
  }
  .field select:focus-visible, .clear:focus-visible { outline: 3px solid var(--color-orange); outline-offset: 2px; }
  .clear {
    font: inherit; background: none; border: 0; padding: var(--space-2) 0; cursor: pointer;
    color: var(--color-link); font-weight: 700; text-decoration: underline; text-underline-offset: 3px;
  }
  .count { margin: var(--space-4) 0 0; color: #444; font-size: var(--text-sm); }
  .none { margin: var(--space-4) 0 0; color: #444; }

  /* Ledger */
  .ledger { list-style: none; margin: var(--space-6) 0 0; padding: 0; }
  .row {
    display: grid; grid-template-columns: 9rem 1fr; gap: var(--space-6);
    padding: var(--space-6) 0; border-top: 1px solid #e3e6ea;
  }
  .row[hidden] { display: none; }
  .thumb { width: 9rem; height: 6.5rem; object-fit: cover; border-radius: 2px; background: #eef1f4; }
  .thumb.blank { background: #eef1f4; }
  .body { max-width: 68ch; }
  .body h3 { margin: 0 0 var(--space-2); font-size: var(--text-xl); line-height: 1.3; }
  .body h3 a { color: var(--color-navy); text-decoration-thickness: 1px; text-underline-offset: 3px; }
  .body h3 a:hover { color: var(--color-link); }
  .dek { margin: 0 0 var(--space-3); color: #444; line-height: 1.6; }
  .facts { margin: 0; display: grid; gap: 2px; font-size: var(--text-sm); }
  .facts div { display: grid; grid-template-columns: 5.5rem 1fr; gap: var(--space-2); }
  .facts dt { color: var(--color-muted); }
  .facts dd { margin: 0; color: var(--color-slate); }

  /* Behind the examples */
  .record { margin-top: var(--space-6); max-width: 68ch; }
  .record h3 { margin: 0 0 var(--space-2); font-size: var(--text-xl); color: var(--color-navy); }
  .years { border-collapse: collapse; width: 100%; font-size: var(--text-sm); }
  .years caption { text-align: left; color: #444; padding-bottom: var(--space-2); }
  .years th, .years td { text-align: left; padding: var(--space-2) var(--space-3) var(--space-2) 0; border-bottom: 1px solid #e3e6ea; }
  .years thead th { color: var(--color-muted); font-weight: 400; }
  .years tbody th { font-weight: 700; color: var(--color-navy); width: 4rem; }
  .years td:nth-child(2) { white-space: nowrap; width: 11rem; }
  .bar { display: block; height: 10px; width: var(--w); background: var(--color-navy); border-radius: 1px; }
  .line { margin: var(--space-3) 0 0; color: #444; line-height: 1.6; }
  .note.small { margin-top: var(--space-6); font-size: var(--text-sm); }

  @media (max-width: 640px) {
    .row { grid-template-columns: 1fr; gap: var(--space-3); }
    .thumb { width: 100%; height: 9rem; }
    .field { max-width: none; }
  }
</style>
