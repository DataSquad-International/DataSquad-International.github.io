---
import Layout from '../layouts/Layout.astro';

const JOIN_FORM =
  'https://github.com/DataSquad-International/DataSquad-International.github.io/issues/new?template=institutional-interest.yml';
---

<Layout
  title="Join the network | DataSquad International"
  description="Introduce yourself to the DataSquad network: people who run paid student teams for research data and software support."
>
  <section class="hero">
    <div class="inner">
      <h1>Join the DataSquad network</h1>
      <p class="lede">
        Connect with people who run paid student teams for research data and
        software support. Whether you’re exploring the model or already
        supervising students, we’d like to hear from you.
      </p>
      <div class="action">
        <a class="btn btn-primary" href={JOIN_FORM} target="_blank" rel="noopener">
          Introduce yourself on GitHub
        </a>
        <p class="note">Requires a GitHub account. Your introduction will be public.</p>
      </div>
      <p class="follow">A network lead will follow up in your GitHub issue.</p>
      <p class="secondary"><a href="/join/starter-kit">Browse the starter kit</a></p>
    </div>
  </section>
</Layout>

<style>
  .hero { background: var(--color-navy); color: var(--color-white); }
  .hero .inner { max-width: var(--max-width); margin: 0 auto; padding: var(--space-16) var(--space-6); }
  .hero h1 { margin: 0 0 var(--space-4); color: var(--color-white); font-size: var(--text-4xl); max-width: 20ch; }
  .lede { margin: 0 0 var(--space-8); font-size: var(--text-lg); color: #cdd6e3; max-width: 58ch; }
  .action { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-4) var(--space-6); margin: 0 0 var(--space-4); }
  .btn {
    display: inline-block; text-decoration: none; font-weight: 700; border-radius: 6px;
    padding: var(--space-3) var(--space-6);
  }
  .btn-primary { background: var(--color-orange); color: var(--color-slate); }
  .btn-primary:hover { background: #ffbe3d; }
  .note { margin: 0; font-size: var(--text-sm); color: #cdd6e3; max-width: 34ch; }
  .follow { margin: 0 0 var(--space-6); color: #cdd6e3; }
  .secondary { margin: 0; }
  .secondary a { color: var(--color-orange); font-weight: 700; text-underline-offset: 3px; }
  .secondary a:hover { color: #ffbe3d; }

  @media (max-width: 720px) {
    .hero .inner { padding: var(--space-8) var(--space-6); }
    .hero h1 { font-size: var(--text-3xl); }
    .lede { margin-bottom: var(--space-6); }
    .btn-primary { display: block; width: 100%; text-align: center; box-sizing: border-box; }
  }
</style>
