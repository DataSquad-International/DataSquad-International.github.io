---
import Layout from '../layouts/Layout.astro';

const groups = [
  {
    title: 'Start a squad',
    items: [
      {
        name: 'Starter kit',
        href: '/join/starter-kit',
        body: 'The roles to fill, a service-scope policy to adapt, the local decisions to make, and a reading list for new analysts.',
      },
      {
        name: 'The adoption path',
        href: '/join',
        body: 'Six steps from "interested" to "running", and how the network coordinates once you have started.',
      },
      {
        name: 'The model',
        href: '/model',
        body: 'What a squad does and does not do, who is on it, and which parts are shared and which are yours to decide.',
      },
    ],
  },
  {
    title: 'See what squads have done',
    items: [
      {
        name: 'Examples',
        href: '/projects',
        body: 'Student projects from Carleton and UCLA, sorted by the kind of work and who it was for.',
      },
      {
        name: 'People and alumni',
        href: '/people',
        body: 'Who is on the squads now, and where former members went.',
      },
    ],
  },
  {
    title: 'Reuse our data',
    items: [
      {
        name: 'Projects as JSON',
        href: '/api/projects.json',
        body: 'Every example project, plus the shared list of work categories and partner types. Use these values when you describe your own squad’s projects so they compare with everyone else’s.',
      },
      {
        name: 'Institutions as JSON',
        href: '/api/institutions.json',
        body: 'The member programs, with their ROR identifiers and local program sites.',
      },
      {
        name: 'Blog feeds',
        href: '/rss.xml',
        body: 'RSS, with Atom (/atom.xml) and JSON Feed (/feed.json) alongside. Posts from member squads are included.',
      },
    ],
  },
  {
    title: 'Code and licenses',
    items: [
      {
        name: 'Site repository',
        href: 'https://github.com/DataSquad-International/DataSquad-International.github.io',
        body: 'The source for this site. Code is BSD-3-Clause and site content is CC BY 4.0, so you can reuse both with credit.',
        external: true,
      },
    ],
  },
];
---

<Layout
  title="Resources | DataSquad International"
  description="Materials for starting and running a DataSquad: the starter kit, example projects, shared data, and licenses."
>
  <section class="hero">
    <div class="inner">
      <h1>Resources</h1>
      <p class="lede">Materials for starting and running a DataSquad.</p>
    </div>
  </section>

  <section class="wrap">
    {groups.map((g) => (
      <section class="group" aria-labelledby={`g-${g.title.replace(/\W+/g, '-').toLowerCase()}`}>
        <h2 id={`g-${g.title.replace(/\W+/g, '-').toLowerCase()}`}>{g.title}</h2>
        <ul class="list">
          {g.items.map((r) => (
            <li>
              <a
                href={r.href}
                target={r.external ? '_blank' : undefined}
                rel={r.external ? 'noopener' : undefined}
              >
                {r.name}{r.external && ' (opens in a new tab)'}
              </a>
              <p>{r.body}</p>
            </li>
          ))}
        </ul>
      </section>
    ))}

    <section class="send">
      <h2>Send us yours</h2>
      <p>
        If your squad has a paper, an assessment instrument, or a set of slides
        that would help the next program get started, we would like to host it or
        link to it. <a href="/contact">Get in touch</a> with what you have and
        who should be credited.
      </p>
    </section>
  </section>
</Layout>

<style>
  .hero { background: var(--color-navy); color: var(--color-white); }
  .hero .inner { max-width: var(--max-width); margin: 0 auto; padding: var(--space-12) var(--space-6); }
  .hero h1 { margin: 0 0 var(--space-3); color: var(--color-white); font-size: var(--text-4xl); }
  .lede { margin: 0; font-size: var(--text-lg); color: #cdd6e3; max-width: 52ch; }

  .wrap { max-width: var(--max-width); margin: 0 auto; padding: var(--space-8) var(--space-6) var(--space-16); }
  .group { padding-top: var(--space-8); }
  .group h2, .send h2 { margin: 0 0 var(--space-3); font-size: var(--text-2xl); color: var(--color-navy); }
  .list { list-style: none; margin: 0; padding: 0; max-width: 68ch; }
  .list li { padding: var(--space-4) 0; border-top: 1px solid #e3e6ea; }
  .list a { font-size: var(--text-lg); font-weight: 700; color: var(--color-navy); text-underline-offset: 3px; }
  .list a:hover { color: var(--color-link); }
  .list p { margin: var(--space-1) 0 0; color: #444; line-height: 1.6; }
  .send { margin-top: var(--space-12); padding-top: var(--space-8); border-top: 3px solid var(--color-navy); max-width: 68ch; }
  .send p { margin: 0; line-height: 1.6; }
  .send a { color: var(--color-link); font-weight: 700; }
</style>
